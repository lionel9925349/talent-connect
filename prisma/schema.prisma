generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model HeroContent {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  title     String
  subtitle  String
  ctaText   String
  ctaLink   String
  updatedAt DateTime @updatedAt

  @@map("hero_content")
}

model JobOffer {
  id           Int      @id @default(autoincrement())
  title        String
  company      String
  location     String
  contractType String
  description  String   @db.Text
  requirements String   @db.Text
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("job_offers")
}

model TrainingOffer {
  id          Int      @id @default(autoincrement())
  title       String
  sector      String
  duration    String
  location    String
  description String   @db.Text
  conditions  String   @db.Text
  startDate   String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("training_offers")
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model Application {
  id        Int      @id @default(autoincrement())
  firstName String
  lastName  String
  email     String
  phone     String
  jobId     Int?
  jobTitle  String
  company   String
  fileNames String[]
  status    String   @default("new")
  locale    String   @default("de")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("applications")
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  firstName String
  lastName  String
  email     String
  phone     String?
  type      String   @default("sonstiges")
  message   String   @db.Text
  status    String   @default("new")
  locale    String   @default("de")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("contact_messages")
}
