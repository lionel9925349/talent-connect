generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model HeroContent {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  title     String
  subtitle  String
  ctaText   String
  ctaLink   String
  updatedAt DateTime @updatedAt

  @@map("hero_content")
}

model JobOffer {
  id           Int      @id @default(autoincrement())
  title        String
  company      String
  location     String
  contractType String
  description  String   @db.Text
  requirements String   @db.Text
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("job_offers")
}

model TrainingOffer {
  id          Int      @id @default(autoincrement())
  title       String
  sector      String
  duration    String
  location    String
  description String   @db.Text
  conditions  String   @db.Text
  startDate   String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("training_offers")
}
